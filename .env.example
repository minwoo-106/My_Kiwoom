# Kiwoom REST API mock-trading credentials only.
# Copy this file to .env and enter values locally. Never commit .env.
KIWOOM_ENV=mock
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=

# 기본값은 절대 주문을 보내지 않는 DRY RUN입니다.
ENABLE_MOCK_ORDER=false
# 실제 자동 모의주문 전에는 한국거래소의 해당 연도 휴장일을 YYYY-MM-DD로 입력하세요.
# 예: MARKET_HOLIDAYS=2026-01-01,2026-03-02
MARKET_HOLIDAYS=

# 마지막 정상 시장 데이터 수신 뒤 이 시간 이상 지나면 신규 매수를 차단합니다.
STALE_DATA_SECONDS=180
# true면 신규 모의 매수를 즉시 중단합니다. 기존 보유 종목의 보호 매도는 유지합니다.
EMERGENCY_STOP=false
